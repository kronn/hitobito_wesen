# Copy to .env next to docker-compose.yaml and fill in the values.
# Database host, name and user as well as the Redis URLs are set in docker-compose.yaml.

## Required

# openssl rand -hex 64
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
# public hostname, used for links in mails and the allowed Host header
RAILS_HOST_NAME=hitobito.example.org

## Recommended

# true when a reverse proxy terminates TLS
RAILS_HOST_SSL=false
# receives the "Passwort vergessen" mail for the root user
RAILS_ROOT_USER_EMAIL=you@example.org

# sending mail; use RAILS_MAIL_DELIVERY_METHOD=file and no config to run without a mail server
RAILS_MAIL_DELIVERY_METHOD=smtp
RAILS_MAIL_DELIVERY_CONFIG="address: smtp.example.org, port: 587, user_name: x, password: y, enable_starttls_auto: true"
# domain of the mailing list addresses, defaults to RAILS_HOST_NAME
# RAILS_MAIL_DOMAIN=

## Optional

# error reporting in Sentry or Glitchtip
# SENTRY_DSN=

# signing key for hitobito as OIDC provider (PEM)
# JWT_SIGNING_KEY=

# puma processes and threads per process
# WEB_CONCURRENCY=1
# RAILS_MAX_THREADS=5

# RAILS_LOG_LEVEL=info

# uploads in S3 instead of the uploads volume
# RAILS_STORAGE_SERVICE=cloudscale
# RAILS_S3_ENDPOINT=
# RAILS_S3_ACCESS_KEY=
# RAILS_S3_SECRET_KEY=
# RAILS_S3_BUCKETNAME=
